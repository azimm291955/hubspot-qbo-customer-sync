# HubSpot private app token (scopes: crm.objects.notes, companies, contacts, owners)
HUBSPOT_TOKEN=
# HubSpot owner ID that sales @-mentions to request a customer
AZ_OWNER_ID=
# QuickBooks Online app credentials and company
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
# First refresh token only; the job rotates and stores it after every run
QBO_REFRESH_TOKEN_SEED=
# Vercel sets this for cron requests
CRON_SECRET=
# 1 = report what would happen, create nothing
DRY_RUN=1
